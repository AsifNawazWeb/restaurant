{
  "name": "restopulse-pos",
  "productName": "RestoPulse POS",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first desktop restaurant POS for Pakistan - PKR, node:sqlite (WAL), ESC/POS thermal printing",
  "type": "module",
