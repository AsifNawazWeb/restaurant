    "test": "vitest run",
    "test:watch": "vitest",
    "build": "electron-vite build",
    "typegen:main": "tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
